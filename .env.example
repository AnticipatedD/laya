# Optional Hugging Face token for private models or higher rate limits.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Sample size for research benchmark scripts (research/scripts/bench_*.py).
# Default used by scripts if unset: 400
BENCH_N=400

# Optional: directory where local model checkpoints live for research scripts.
# Defaults to ./models relative to the repo root if unset.
LAYA_MODEL_DIR=./models
